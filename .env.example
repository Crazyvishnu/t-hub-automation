# Required in production
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=replace-me
RUN_SECRET=replace-with-a-long-random-value

# OpenWA WhatsApp Settings (Required if using WhatsApp)
OPENWA_URL=http://your-livemyapp-url.com
OPENWA_API_KEY=your_api_key
OPENWA_SESSION_ID=default
WHATSAPP_TARGET_NUMBER=919876543210
TELEGRAM_MODE=FALLBACK

# Optional
LOG_LEVEL=INFO
THUB_EVENTS_URL=https://tevents.t-hub.co/events
REQUEST_TIMEOUT_SECONDS=25
