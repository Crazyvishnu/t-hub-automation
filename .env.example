# ─────────────────────────────────────────────────────────
# T-Hub Event Radar — environment variables
# Copy to .env and fill in real values.  NEVER commit .env.
# ─────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# ── Telegram fallback (required) ─────────────────────────
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=replace-me

# ── Security ─────────────────────────────────────────────
RUN_SECRET=replace-with-a-long-random-value

# ── OpenWA WhatsApp gateway (required for WhatsApp) ──────
# Set OPENWA_URL to the public HTTPS endpoint of your OpenWA deployment.
# Works with any host: HeavenCloud, livemy.app, a VPS, or localhost.
# Example HeavenCloud URL: https://your-app.heavencloud.app
OPENWA_URL=https://your-openwa-host.example.com
OPENWA_API_KEY=your_openwa_api_key
OPENWA_SESSION_ID=your-session-uuid-or-name
WHATSAPP_TARGET_NUMBER=919876543210

# FALLBACK = use Telegram only if WhatsApp fails (recommended)
# ALWAYS   = send to both WhatsApp and Telegram every time
TELEGRAM_MODE=FALLBACK

# ── WhatsApp-specific timeout (default: 10 s) ────────────
# Keep this short so a slow/dead OpenWA never stalls the pipeline.
WHATSAPP_TIMEOUT_SECONDS=10

# ── Circuit breaker (default: 3 failures) ────────────────
# After this many consecutive WhatsApp failures, the manager bypasses
# WhatsApp and uses Telegram directly until WhatsApp recovers.
OPENWA_FAILURE_THRESHOLD=3

# ── Optional ─────────────────────────────────────────────
LOG_LEVEL=INFO
THUB_EVENTS_URL=https://tevents.t-hub.co/events
REQUEST_TIMEOUT_SECONDS=25
